{
  "name": "campusos-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --exclude tests/backend.integration.test.tsx",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:integration": "vitest run tests/backend.integration.test.tsx",
    "test:prepare": "node tests/backend-fixture.mjs --prepare && npm --prefix tests/.backend ci",
    "test:server": "node tests/backend-fixture.mjs --serve"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.5",
    "@hookform/resolvers": "3.10.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.2",
    "react-hook-form": "7.54.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/node": "22.13.0",
    "@typescript-eslint/eslint-plugin": "8.24.0",
    "@typescript-eslint/parser": "8.24.0",
    "@vitejs/plugin-react": "4.7.0",
    "@testing-library/react": "16.2.0",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "jsdom": "26.0.0",
    "postcss": "8.5.6",
    "prettier": "3.5.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
